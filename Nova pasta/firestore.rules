rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCampaignOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isCampaignMember() {
      return signedIn() && resource.data.membros[request.auth.uid] == true;
    }

    function isJoiningSelf() {
      return signedIn()
        && resource.data.membros[request.auth.uid] != true
        && request.resource.data.membros[request.auth.uid] == true;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /campaigns/{campaignId} {
      // Necessário para o convidado logado conseguir abrir o link antes de virar membro.
      allow get: if signedIn();
      allow list: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isCampaignOwner() || isCampaignMember() || isJoiningSelf();
      allow delete: if isCampaignOwner();
    }

    match /campanhas/{campaignId} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isCampaignOwner() || isCampaignMember() || isJoiningSelf();
      allow delete: if isCampaignOwner();
    }

    match /characters/{characterId} {
      allow read, write: if signedIn();
    }

    match /personagens/{characterId} {
      allow read, write: if signedIn();
    }
  }
}
